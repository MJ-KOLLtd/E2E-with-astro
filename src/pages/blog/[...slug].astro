---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBackdrop from '../../components/HeroBackdrop.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const formattedDate = post.data.pubDate.toLocaleDateString('en-PH', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---
<BaseLayout
  title={`${post.data.title} | ESQUARE ESTATES`}
  description={post.data.description}
  activeNav="blog"
>
  <section class="page-hero has-render has-texture">
    <HeroBackdrop render="/images/commonwealth/page02-img2.jpeg" />
    <div class="container inner hero-glass">
      <span class="eyebrow center"><a href="/blog/">Blog</a></span>
      <h1>{post.data.title}</h1>
      <div class="blog-post-meta">
        <span><i class="fas fa-calendar-alt"></i> {formattedDate}</span>
        <span><i class="fas fa-user"></i> {post.data.author}</span>
        {post.data.tags && post.data.tags.map(tag => (
          <span style="background:rgba(255,184,66,.18);color:var(--gold-300);padding:3px 10px;border-radius:20px;font-weight:600;font-size:.78rem">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <div class="blog-post">
    {post.data.image && (
      <img src={post.data.image} alt={post.data.title}
           style="width:100%;border-radius:var(--r-lg);margin-bottom:40px;box-shadow:var(--sh-lg)"/>
    )}

    <div class="blog-content">
      <Content />
    </div>

    <div class="blog-cta">
      <h3>Interested in our developments?</h3>
      <p>Schedule a private viewing of ESQUARE ESTATES Commonwealth or 9 Handel Homes.</p>
      <a href="/contact/" class="btn btn-primary btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
    </div>

    <div style="text-align:center;margin-top:32px">
      <a href="/blog/" class="btn-link"><i class="fas fa-arrow-left" style="transform:scaleX(-1)"></i> Back to all posts</a>
    </div>
  </div>
</BaseLayout>