---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="Blog | Real Estate Insights — Esquare Estates"
  description="Property tips, investment insights, and Bulacan real estate guides from Esquare Estates."
  activeNav="blog"
>
  <section class="page-hero">
    <div class="container inner">
      <span class="eyebrow center">Blog</span>
      <h1>Real estate insights for buyers &amp; investors.</h1>
      <p>Property tips, Bulacan market updates, and investment guides — written for people ready to act.</p>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container">
      {posts.length === 0 ? (
        <div style="text-align:center;padding:80px 0;color:var(--ink-400)">
          <i class="fas fa-pencil" style="font-size:3rem;margin-bottom:16px;display:block"></i>
          <p>No blog posts yet. Add your first post in <code>src/content/blog/</code>.</p>
        </div>
      ) : (
        <div class="blog-grid">
          {posts.map(post => (
            <article class="blog-card reveal">
              <div class="blog-card-img">
                {post.data.image
                  ? <img src={post.data.image} alt={post.data.title} style="width:100%;height:100%;object-fit:cover"/>
                  : <i class="fas fa-house-chimney"></i>
                }
              </div>
              <div class="blog-card-body">
                <div class="blog-card-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-PH', { year:'numeric', month:'long', day:'numeric' })}
                  </time>
                  {post.data.tags && post.data.tags.slice(0,2).map(tag => (
                    <span style="background:var(--gold-100);color:var(--gold-600);padding:2px 9px;border-radius:20px;font-weight:600">{tag}</span>
                  ))}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <a href={`/blog/${post.slug}/`} class="btn btn-ghost">Read more <i class="fas fa-arrow-right arr"></i></a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Ready to invest in Bulacan?</h2>
      <p>Get the Oro Villas 2 price list and available blocks from a property specialist.</p>
      <a href="/contact/" class="btn btn-dark btn-lg">Inquire now <i class="fas fa-arrow-right arr"></i></a>
    </div>
  </section>
</BaseLayout>
