---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Oro Villas 2 — Residential Lots in Bocaue, Bulacan | Esquare Estates"
  description="Oro Villas 2: flood-free residential lots 60–100 sqm along McArthur Highway in Bocaue, Bulacan. Reserve a lot or get the price list."
  activeNav="projects"
>
<!-- PROJECT HERO -->
    <section class="hero">
      <svg class="hero-topo" viewBox="0 0 560 560" aria-hidden="true">
        <rect x="40" y="40" width="480" height="480" rx="120" transform="rotate(8 280 280)"/>
        <rect x="95" y="95" width="370" height="370" rx="95" transform="rotate(8 280 280)"/>
        <rect x="150" y="150" width="260" height="260" rx="70" transform="rotate(8 280 280)"/>
        <rect x="205" y="205" width="150" height="150" rx="45" transform="rotate(8 280 280)"/>
      </svg>
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Projects · Oro Villas 2</span>
          <h1>Oro Villas 2</h1>
          <p class="hero-sub">Secure a residential lot in a flood-free, master-planned Bulacan community along McArthur Highway — minutes from the Philippine Arena, with NLEx access and strong long-term appreciation.</p>
          <div class="hero-buttons">
            <a href="#inquire" class="btn btn-primary btn-lg">Reserve a Lot <i class="fas fa-arrow-right arr"></i></a>
            <a href="#inquire" class="btn btn-outline btn-lg">Get the Price List</a>
          </div>
          <div class="hero-trust">
            <div class="ht"><b>60–100</b><span>sqm lot cuts</span></div>
            <div class="ht"><b>Pre-selling</b><span>Current status</span></div>
            <div class="ht"><b>Flood-free</b><span>Elevated site</span></div>
          </div>
        </div>
        <div class="hero-visual">
          <span class="hero-tag">Brgy. Wakas, Bocaue</span>
          <div class="hero-frame">
            <!-- TODO: drop a real Oro Villas 2 hero photo / render here (object-fit:cover) -->
            <div class="ph-icon"><i class="fas fa-tree-city"></i><span>Oro Villas 2 — Site Photo</span></div>
          </div>
          <div class="lot-card">
            <div class="lc-head">Lot Snapshot</div>
            <div class="lc-row"><span>Lot cuts</span><b>60–100 sqm</b></div>
            <div class="lc-row"><span>Status</span><b>Pre-selling</b></div>
            <div class="lc-row"><span>Terms</span><b>Flexible</b></div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY -->
    <section class="section bg-cream">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">Why Oro Villas 2</span>
          <h2>A lot that holds its value — and grows with you.</h2>
          <p>Location, land size, and timing are the three levers of residential value. Oro Villas 2 was positioned to win on all three.</p>
        </div>
        <div class="why-grid">
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-location-dot"></i></div><h3>Prime frontage</h3><p>Directly along McArthur Highway in Brgy. Wakas, Bocaue — fast access to NLEx and Metro Manila.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-vector-square"></i></div><h3>Right-sized cuts</h3><p>60–100 sqm residential lots — efficient, buildable, and priced for first homes and investors alike.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-arrow-trend-up"></i></div><h3>Real appreciation</h3><p>Beside the Philippine Arena and a growing commercial and infrastructure corridor in Bulacan.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-shield-halved"></i></div><h3>Flood-free &amp; secure</h3><p>An elevated, well-drained, master-planned community built for peace of mind, day and night.</p></div>
        </div>
      </div>
    </section>

    <!-- LOCATION -->
    <section class="section bg-white">
      <div class="container">
        <div class="loc-grid">
          <div class="loc-copy reveal">
            <span class="eyebrow">Connectivity</span>
            <h2 style="font-size:clamp(2rem,3.6vw,2.95rem);margin:16px 0 18px">Everything you need is already nearby.</h2>
            <p style="color:var(--ink-600);font-size:1.08rem;margin-bottom:8px">In real estate, location isn't a feature — it's the asset. Here's what surrounds Oro Villas 2.</p>
            <div class="loc-list">
              <div class="loc-item"><div class="li-time">10<small>minutes</small></div><div class="li-body"><b>Philippine Arena</b><span>The world's largest indoor arena and its growing district.</span></div></div>
              <!-- TODO: confirm/replace estimated drive context below with verified times -->
              <div class="loc-item"><div class="li-time">Direct<small>access</small></div><div class="li-body"><b>McArthur Highway &amp; NLEx</b><span>Straightforward route to Manila and Central Luzon.</span></div></div>
              <div class="loc-item"><div class="li-time">Near<small>essentials</small></div><div class="li-body"><b>Hospitals, schools &amp; public market</b><span>Daily needs and emergencies covered within reach.</span></div></div>
              <div class="loc-item"><div class="li-time">Rising<small>corridor</small></div><div class="li-body"><b>Commercial &amp; infrastructure hubs</b><span>Ongoing development driving long-term land value.</span></div></div>
            </div>
          </div>
          <div class="map-embed reveal">
            <!-- TODO (recommended): replace this iframe with the EXACT embed for your site.
                 Google Maps → search your location → Share → "Embed a map" → Copy HTML → paste the
                 <iframe> here (the CSS controls its size). This default centers on the barangay —
                 verify the pin sits on your actual site, or use precise coordinates: q=14.79,120.92 -->
            <iframe
              src="https://www.google.com/maps?q=Oro%20Villas%202%2C%20Brgy.%20Wakas%2C%20Bocaue%2C%20Bulacan&z=15&output=embed"
              title="Oro Villas 2 — Brgy. Wakas, Bocaue, Bulacan"
              loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <div class="map-actions">
              <span><i class="fas fa-location-dot"></i> Oro Villas 2 · Brgy. Wakas, Bocaue, Bulacan</span>
              <a class="btn-link" target="_blank" rel="noopener"
                 href="https://www.google.com/maps/dir/?api=1&destination=Oro%20Villas%202%2C%20Brgy.%20Wakas%2C%20Bocaue%2C%20Bulacan">Get directions <i class="fas fa-arrow-right arr"></i></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LOT OPTIONS -->
    <section class="section bg-cream">
      <div class="container">
        <div class="section-head center reveal">
          <span class="eyebrow">Lot Options</span>
          <h2>Choose the cut that fits your plan.</h2>
          <p>Indicative configurations below. Exact pricing and available blocks are released through the official price list.</p>
        </div>
        <div class="lot-grid">
          <div class="lot-tier reveal">
            <div class="lt-size">60<small> sqm</small></div>
            <h3>Starter Lot</h3>
            <ul>
              <li><i class="fas fa-check"></i> Ideal first home or rental build</li>
              <li><i class="fas fa-check"></i> Lowest entry point</li>
              <li><i class="fas fa-check"></i> Flexible reservation terms</li>
            </ul>
            <a href="#inquire" class="btn btn-ghost">Check availability</a>
          </div>
          <div class="lot-tier feature reveal">
            <span class="badge">Most popular</span>
            <div class="lt-size">80<small> sqm</small></div>
            <h3>Family Lot</h3>
            <ul>
              <li><i class="fas fa-check"></i> Room for a 2-storey family home</li>
              <li><i class="fas fa-check"></i> Best balance of size &amp; value</li>
              <li><i class="fas fa-check"></i> Premium block positions</li>
            </ul>
            <a href="#inquire" class="btn btn-primary">Reserve this cut</a>
          </div>
          <div class="lot-tier reveal">
            <div class="lt-size">100<small> sqm</small></div>
            <h3>Premium Lot</h3>
            <ul>
              <li><i class="fas fa-check"></i> Maximum space &amp; frontage</li>
              <li><i class="fas fa-check"></i> Strongest resale potential</li>
              <li><i class="fas fa-check"></i> Limited corner units</li>
            </ul>
            <a href="#inquire" class="btn btn-ghost">Check availability</a>
          </div>
        </div>
        <p class="pricing-note"><i class="fas fa-lock" style="color:var(--gold-600)"></i> Pre-selling prices are shared privately. <a href="#inquire" class="btn-link">Get the full price list <i class="fas fa-arrow-right arr"></i></a></p>
      </div>
    </section>

    <!-- GALLERY / COMMUNITY -->
    <section class="section bg-white">
      <div class="container">
        <div class="proj-grid">
          <div class="gallery reveal">
            <!-- TODO: replace all cells with real photos (entrance, roads, open space, model) -->
            <div class="g-cell tall"><i class="fas fa-image"></i><span>Entrance gate</span></div>
            <div class="g-cell"><i class="fas fa-image"></i><span>Wide roads</span></div>
            <div class="g-cell"><i class="fas fa-image"></i><span>Open space</span></div>
          </div>
          <div class="proj-text reveal">
            <span class="eyebrow">Inside the community</span>
            <h2 style="font-size:clamp(2rem,3.6vw,2.95rem);margin:16px 0 8px">Built for everyday living.</h2>
            <p style="color:var(--ink-600);font-size:1.06rem">A peaceful, flood-free community designed for convenience and long-term value.</p>
            <ul class="feature-list">
              <li><i class="fas fa-circle-check"></i> 10 minutes from the Philippine Arena</li>
              <li><i class="fas fa-circle-check"></i> McArthur Highway frontage with NLEx access</li>
              <li><i class="fas fa-circle-check"></i> Near hospitals, schools &amp; public market</li>
              <li><i class="fas fa-circle-check"></i> Strong potential for property appreciation</li>
            </ul>
            <a href="#inquire" class="btn btn-primary btn-lg">Book a site visit <i class="fas fa-arrow-right arr"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- LEAD CAPTURE -->
    <section class="section leadgen" id="inquire">
      <div class="container lead-grid">
        <div class="lead-copy reveal">
          <span class="eyebrow">Get Started</span>
          <h2>Get the official price list &amp; site map.</h2>
          <p>Tell us what you're looking for. A property specialist will send full pricing, available blocks, and payment terms — no pressure.</p>
          <ul class="lead-points">
            <li><i class="fas fa-file-invoice"></i> Complete pre-selling price list</li>
            <li><i class="fas fa-map-location-dot"></i> Site development &amp; lot map</li>
            <li><i class="fas fa-handshake"></i> Flexible payment &amp; reservation terms</li>
            <li><i class="fas fa-bolt"></i> Fast reply via call, Viber, or email</li>
          </ul>
        </div>
        <!-- NOTE: connect this form to a real handler (Formspree, HubSpot, GTM event, or your CRM). -->
        <div class="lead-form reveal">
          <h3>Inquire about Oro Villas 2</h3>
          <p class="lf-sub">Fields marked * are required.</p>
          <div class="field"><label>Full name *</label><input type="text" placeholder="Juan Dela Cruz"></div>
          <div class="field-row">
            <div class="field"><label>Mobile *</label><input type="tel" placeholder="0917 000 0000"></div>
            <div class="field"><label>Email</label><input type="email" placeholder="you@email.com"></div>
          </div>
          <div class="field-row">
            <div class="field"><label>I am a *</label>
              <select><option>End-user / home buyer</option><option>Investor</option><option>Broker / seller</option></select>
            </div>
            <div class="field"><label>Preferred lot</label>
              <select><option>Any</option><option>60 sqm</option><option>80 sqm</option><option>100 sqm</option></select>
            </div>
          </div>
          <div class="field"><label>Message</label><textarea rows="3" placeholder="When are you planning to buy? Any questions?"></textarea></div>
          <a href="#" class="btn btn-primary">Send my inquiry <i class="fas fa-paper-plane"></i></a>
          <p class="fineprint">By submitting, you agree to be contacted about Esquare Estates projects.</p>
        </div>
      </div>
    </section>

    <!-- EVENT TEASER -->
    <section class="section event">
      <div class="container">
        <div class="section-head reveal" style="margin-bottom:36px">
          <span class="eyebrow">Upcoming Event</span>
          <h2 style="font-size:clamp(2rem,3.4vw,2.7rem);margin-top:16px">See it for yourself.</h2>
        </div>
        <div class="event-card reveal">
          <div class="event-info">
            <span class="event-badge"><i class="far fa-calendar-alt"></i> June 25, 2026</span>
            <h3>Oro Villas 2 Launch Event</h3>
            <p class="e-time">10:00 AM – 2:00 PM · On-site networking</p>
            <p>A Modern Filipino Gathering for brokers, sellers, and investors — site tour, broker incentives, a Filipino buffet, and a raffle. Slots are limited.</p>
            <a href="/events/" class="btn btn-primary btn-lg">Reserve your slot <i class="fas fa-arrow-right arr"></i></a>
          </div>
          <div class="event-side">
            <div class="es-item"><b>50–100</b><span>Guests expected</span></div>
            <div class="es-item"><b>70%</b><span>Broker accreditation target</span></div>
            <div class="es-item"><b>Lechon</b><span>&amp; full Filipino feast</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BAND -->
    <section class="cta-band">
      <div class="container">
        <h2>Lots are moving. Yours shouldn't wait.</h2>
        <p>Pre-selling prices won't last. Lock in your lot at Oro Villas 2 today.</p>
        <a href="#inquire" class="btn btn-dark btn-lg">Reserve a lot now <i class="fas fa-arrow-right arr"></i></a>
      </div>
    </section>
</BaseLayout>
