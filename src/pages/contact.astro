---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import InquiryForm from '../components/InquiryForm.astro';
---
<BaseLayout
  title="Contact Us | ESQUARE ESTATES"
  description="Get in touch with ESQUARE ESTATES. Schedule a viewing of ESQUARE ESTATES Commonwealth or 9 Handel Homes in Quezon City."
  activeNav="contact"
>

<style>
  /* ── layout ── */
  .contact-wrap {
    position: relative;
    z-index: 2;
    max-width: 1140px;
    margin: 0 auto;
    padding: 72px 24px;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 800px) {
    .contact-wrap { grid-template-columns: 1fr; gap: 40px; }
  }

  /* ── left info ── */
  .contact-section {
    position: relative;
    z-index: 2;
    background: var(--cream);
  }
  .contact-info h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--navy-800);
    margin-bottom: 8px;
  }
  .contact-info p.lead {
    color: var(--ink);
    margin-bottom: 36px;
    line-height: 1.7;
    font-weight: 500;
  }
  .info-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 28px;
    padding: 20px;
    background: var(--cream);
    border-radius: 12px;
    border-left: 3px solid var(--gold-500);
  }
  .info-card .icon {
    width: 40px; height: 40px;
    background: var(--navy-800);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: var(--gold-300);
    font-size: .9rem;
  }
  .info-card .text strong {
    display: block;
    font-family: var(--serif);
    color: var(--navy-800);
    font-size: .9rem;
    font-weight: 700;
    margin-bottom: 2px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .info-card .text span {
    color: var(--ink);
    font-size: .95rem;
    line-height: 1.5;
    font-weight: 500;
  }

  .contact-wrap .inquiry-form .field { display: flex; flex-direction: column; margin-bottom: 18px; }
  .contact-wrap .inquiry-form .field label {
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--navy-800);
    margin-bottom: 6px;
  }
  .contact-wrap .inquiry-form .field input,
  .contact-wrap .inquiry-form .field select,
  .contact-wrap .inquiry-form .field textarea {
    font-family: var(--sans);
    font-size: .95rem;
    padding: 12px 16px;
    border: 1.5px solid #d8dde6;
    border-radius: 10px;
    color: var(--ink);
    background: #fafafa;
    transition: border-color .2s, box-shadow .2s;
    outline: none;
    width: 100%;
  }
  .contact-wrap .inquiry-form .field input:focus,
  .contact-wrap .inquiry-form .field select:focus,
  .contact-wrap .inquiry-form .field textarea:focus {
    border-color: var(--gold-500);
    box-shadow: 0 0 0 3px rgba(255,184,66,.18);
    background: #fff;
  }
  .contact-wrap .inquiry-form .field textarea { resize: vertical; min-height: 120px; }

  /* ── map ── */
  .map-section {
    background: var(--cream);
    padding: 60px 24px;
  }
  .map-section .container { max-width: 1140px; margin: 0 auto; }
  .map-section h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--navy-800);
    margin-bottom: 6px;
  }
  .map-section p { color: var(--ink-600); margin-bottom: 28px; }
  .map-frame {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(2,38,75,.10);
    height: 400px;
  }
  .map-frame iframe { width: 100%; height: 100%; border: none; }
</style>

<!-- HERO -->
<section class="page-hero has-render has-texture">
  <HeroBackdrop render="/images/commonwealth/page01-img2.jpeg" />
  <div class="container inner hero-glass">
    <span class="eyebrow center">Get in Touch</span>
    <h1>Schedule a Viewing</h1>
    <p>Send us a message and a property specialist will arrange your private viewing within 24 hours.</p>
  </div>
</section>

<!-- MAIN CONTENT -->
<section class="section bg-cream contact-section" style="padding-top:72px;padding-bottom:72px">
<div class="contact-wrap" style="padding:0">

  <!-- LEFT: Info -->
  <div class="contact-info">
    <h2>Let's discuss our developments</h2>
    <p class="lead">Whether you're ready to schedule a viewing or still exploring options, we're happy to walk you through ESQUARE ESTATES Commonwealth or 9 Handel Homes — including specifications, floor plans, and availability.</p>

    <div class="info-card">
      <div class="icon"><i class="fas fa-phone-alt"></i></div>
      <div class="text">
        <strong>Phone / Viber</strong>
        <!-- TODO: Replace with real number -->
        <span>+63 (2) 1234 5678</span>
      </div>
    </div>

    <div class="info-card">
      <div class="icon"><i class="fas fa-envelope"></i></div>
      <div class="text">
        <strong>Email</strong>
        <!-- TODO: Replace with real email -->
        <span>hello@esquareestates.com</span>
      </div>
    </div>

    <div class="info-card">
      <div class="icon"><i class="fas fa-map-pin"></i></div>
      <div class="text">
        <strong>Project Locations</strong>
        <span>ESQUARE ESTATES Commonwealth — Ciudad Regina, Quezon City<br>9 Handel Homes — Don Jose Heights, Quezon City</span>
      </div>
    </div>

    <div class="info-card">
      <div class="icon"><i class="fas fa-clock"></i></div>
      <div class="text">
        <strong>Office Hours</strong>
        <!-- TODO: Replace with real hours -->
        <span>Mon–Sat, 9:00 AM – 6:00 PM</span>
      </div>
    </div>
  </div>

  <InquiryForm
    id="contact"
    variant="card"
    title="Send us a message"
    subject="ESQUARE ESTATES — Contact Page Inquiry"
  />
</div>
</section>

<!-- MAP -->
<div class="map-section">
  <div class="container">
    <h2>Find Us</h2>
    <p>ESQUARE ESTATES Commonwealth — Ciudad Regina, Quezon City (primary showroom area)</p>
    <div class="map-frame">
      <iframe
        src="https://maps.google.com/maps?q=Ciudad+Regina+Quezon+City&output=embed"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="ESQUARE ESTATES Commonwealth Location">
      </iframe>
    </div>
  </div>
</div>

</BaseLayout>
