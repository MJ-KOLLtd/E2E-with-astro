---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Us | Esquare Estates"
  description="Get in touch with Esquare Estates. Inquire about Oro Villas 2 lots in Bocaue, Bulacan — price list, site tripping, and payment terms available."
  activeNav="contact"
>

<style>
  .contact-hero {
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-800) 100%);
    padding: 100px 0 60px;
    text-align: center;
    color: #fff;
  }
  .contact-hero .eyebrow {
    display: inline-block;
    font-family: var(--serif);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--gold-500);
    margin-bottom: 16px;
  }
  .contact-hero h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 16px;
  }
  .contact-hero p {
    font-size: 1.1rem;
    color: rgba(255,255,255,.7);
    max-width: 540px;
    margin: 0 auto;
  }

  /* ── layout ── */
  .contact-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 72px 24px;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 800px) {
    .contact-wrap { grid-template-columns: 1fr; gap: 40px; }
  }

  /* ── left info ── */
  .contact-info h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--navy-800);
    margin-bottom: 8px;
  }
  .contact-info p.lead {
    color: var(--ink-600);
    margin-bottom: 36px;
    line-height: 1.7;
  }
  .info-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 28px;
    padding: 20px;
    background: var(--cream);
    border-radius: 12px;
    border-left: 3px solid var(--gold-500);
  }
  .info-card .icon {
    width: 40px; height: 40px;
    background: var(--navy-800);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: var(--gold-400);
    font-size: .9rem;
  }
  .info-card .text strong {
    display: block;
    font-family: var(--serif);
    color: var(--navy-800);
    font-size: .9rem;
    font-weight: 700;
    margin-bottom: 2px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .info-card .text span {
    color: var(--ink-600);
    font-size: .95rem;
    line-height: 1.5;
  }

  /* ── form card ── */
  .form-card {
    background: #fff;
    border-radius: 20px;
    padding: 44px 40px;
    box-shadow: 0 4px 40px rgba(2,38,75,.10);
    border: 1px solid rgba(2,38,75,.06);
  }
  @media (max-width: 600px) { .form-card { padding: 28px 20px; } }
  .form-card h3 {
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--navy-800);
    margin-bottom: 6px;
  }
  .form-card p.sub {
    color: var(--ink-600);
    font-size: .92rem;
    margin-bottom: 28px;
  }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }

  .field { display: flex; flex-direction: column; margin-bottom: 18px; }
  .field label {
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--navy-800);
    margin-bottom: 6px;
  }
  .field input,
  .field select,
  .field textarea {
    font-family: var(--sans);
    font-size: .95rem;
    padding: 12px 16px;
    border: 1.5px solid #d8dde6;
    border-radius: 10px;
    color: var(--ink);
    background: #fafafa;
    transition: border-color .2s, box-shadow .2s;
    outline: none;
    width: 100%;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--gold-500);
    box-shadow: 0 0 0 3px rgba(255,184,66,.18);
    background: #fff;
  }
  .field textarea { resize: vertical; min-height: 120px; }

  .btn-submit {
    width: 100%;
    padding: 15px;
    background: var(--gold-500);
    color: var(--navy-900);
    border: none;
    border-radius: 12px;
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: .02em;
    cursor: pointer;
    transition: background .2s, transform .15s;
    margin-top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .btn-submit:hover { background: var(--gold-600); transform: translateY(-1px); }
  .btn-submit:disabled { opacity: .6; cursor: not-allowed; transform: none; }

  /* ── success / error ── */
  .form-success, .form-error { display: none; }
  .form-success.show, .form-error.show { display: block; }

  .form-success {
    text-align: center;
    padding: 48px 24px;
  }
  .form-success .check {
    width: 64px; height: 64px;
    background: #e8f7ee;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    font-size: 1.8rem;
    color: #2da05a;
  }
  .form-success h4 {
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--navy-800);
    margin-bottom: 8px;
  }
  .form-success p { color: var(--ink-600); font-size: .95rem; }

  .form-error-msg {
    background: #fff3f3;
    border: 1px solid #f5c6c6;
    border-radius: 8px;
    padding: 12px 16px;
    color: #c0392b;
    font-size: .9rem;
    margin-bottom: 16px;
    display: none;
  }
  .form-error-msg.show { display: block; }

  /* ── map ── */
  .map-section {
    background: var(--cream);
    padding: 60px 24px;
  }
  .map-section .container { max-width: 1140px; margin: 0 auto; }
  .map-section h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
    color: var(--navy-800);
    margin-bottom: 6px;
  }
  .map-section p { color: var(--ink-600); margin-bottom: 28px; }
  .map-frame {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(2,38,75,.10);
    height: 400px;
  }
  .map-frame iframe { width: 100%; height: 100%; border: none; }
</style>

<!-- HERO -->
<div class="contact-hero">
  <span class="eyebrow">Get in Touch</span>
  <h1>Inquire About Oro Villas 2</h1>
  <p>Send us a message and a property specialist will get back to you within 24 hours.</p>
</div>

<!-- MAIN CONTENT -->
<div class="contact-wrap">

  <!-- LEFT: Info -->
  <div class="contact-info">
    <h2>Let's talk about your future lot</h2>
    <p class="lead">Whether you're ready to reserve or still comparing options, we're happy to walk you through pricing, lot availability, and flexible payment terms.</p>

    <div class="info-card">
      <div class="icon"><i class="fas fa-phone-alt"></i></div>
      <div class="text">
        <strong>Phone / Viber</strong>
        <!-- TODO: Replace with real number -->
        <span>+63 (2) 1234 5678</span>
      </div>
    </div>

    <div class="info-card">
      <div class="icon"><i class="fas fa-envelope"></i></div>
      <div class="text">
        <strong>Email</strong>
        <!-- TODO: Replace with real email -->
        <span>hello@esquareestates.com</span>
      </div>
    </div>

    <div class="info-card">
      <div class="icon"><i class="fas fa-map-pin"></i></div>
      <div class="text">
        <strong>Project Location</strong>
        <span>Brgy. Wakas, Bocaue, Bulacan<br>Along McArthur Highway</span>
      </div>
    </div>

    <div class="info-card">
      <div class="icon"><i class="fas fa-clock"></i></div>
      <div class="text">
        <strong>Office Hours</strong>
        <!-- TODO: Replace with real hours -->
        <span>Mon–Sat, 9:00 AM – 6:00 PM</span>
      </div>
    </div>
  </div>

  <!-- RIGHT: Form -->
  <div class="form-card">

    <!-- Default form view -->
    <div id="formWrap">
      <h3>Send us a message</h3>
      <p class="sub">All fields marked * are required. We reply within 1 business day.</p>

      <div class="form-error-msg" id="errorMsg">
        Something went wrong. Please try again or message us on Viber.
      </div>

      <form id="contactForm" novalidate>
        <div class="form-row">
          <div class="field">
            <label for="fname">Full Name *</label>
            <input type="text" id="fname" name="name" placeholder="Juan dela Cruz" required>
          </div>
          <div class="field">
            <label for="fphone">Phone / Viber *</label>
            <input type="tel" id="fphone" name="phone" placeholder="+63 9XX XXX XXXX" required>
          </div>
        </div>

        <div class="field">
          <label for="femail">Email Address *</label>
          <input type="email" id="femail" name="email" placeholder="juan@email.com" required>
        </div>

        <div class="field">
          <label for="ftype">What can we help you with? *</label>
          <select id="ftype" name="inquiry_type" required>
            <option value="" disabled selected>Select an option...</option>
            <option value="Price list request">Price list & lot availability</option>
            <option value="Site tripping">Schedule a site tripping</option>
            <option value="Reservation inquiry">Reservation / spot cash inquiry</option>
            <option value="Accreditation - broker">Broker / agent accreditation</option>
            <option value="Partnership - investor">Investor partnership</option>
            <option value="General inquiry">General question</option>
          </select>
        </div>

        <div class="field">
          <label for="fmsg">Message</label>
          <textarea id="fmsg" name="message" placeholder="Tell us what you're looking for, or ask anything about Oro Villas 2..."></textarea>
        </div>

        <!-- Formspree honeypot — leave blank, catches bots -->
        <input type="text" name="_gotcha" style="display:none">

        <button type="submit" class="btn-submit" id="submitBtn">
          <span id="btnText">Send Message</span>
          <i class="fas fa-arrow-right" id="btnIcon"></i>
          <i class="fas fa-spinner fa-spin" id="btnSpinner" style="display:none"></i>
        </button>
      </form>
    </div>

    <!-- Success state (shown after submit) -->
    <div class="form-success" id="formSuccess">
      <div class="check"><i class="fas fa-check"></i></div>
      <h4>Message received!</h4>
      <p>Thanks for reaching out. A property specialist from Esquare Estates will contact you within 1 business day — usually sooner.</p>
      <p style="margin-top:16px;font-size:.85rem;color:var(--ink-600)">While you wait, you can <a href="/projects/oro-villas/" style="color:var(--gold-600);font-weight:600">browse Oro Villas 2 details →</a></p>
    </div>

  </div>
</div>

<!-- MAP -->
<div class="map-section">
  <div class="container">
    <h2>Find Us</h2>
    <p>Oro Villas 2 — Brgy. Wakas, Bocaue, Bulacan (along McArthur Highway)</p>
    <div class="map-frame">
      <!-- TODO: Replace with the actual Google Maps embed for the lot.
           Get it from: maps.google.com → search the address → Share → Embed a map → copy the iframe -->
      <iframe
        src="https://maps.google.com/maps?q=Brgy.+Wakas+Bocaue+Bulacan&output=embed"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Oro Villas 2 Location">
      </iframe>
    </div>
  </div>
</div>

<script>
  const form     = document.getElementById('contactForm');
  const wrap     = document.getElementById('formWrap');
  const success  = document.getElementById('formSuccess');
  const errorMsg = document.getElementById('errorMsg');
  const btn      = document.getElementById('submitBtn');
  const btnText  = document.getElementById('btnText');
  const btnIcon  = document.getElementById('btnIcon');
  const spinner  = document.getElementById('btnSpinner');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Basic validation
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Loading state
    btn.disabled = true;
    btnText.textContent = 'Sending...';
    btnIcon.style.display = 'none';
    spinner.style.display = 'inline-block';
    errorMsg.classList.remove('show');

    try {
      const res = await fetch('https://formspree.io/f/mqeoaykr', {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok) {
        // Show success, hide form
        wrap.style.display = 'none';
        success.classList.add('show');
      } else {
        throw new Error('Server error');
      }
    } catch {
      // Show error, re-enable button
      errorMsg.classList.add('show');
      btn.disabled = false;
      btnText.textContent = 'Send Message';
      btnIcon.style.display = 'inline-block';
      spinner.style.display = 'none';
    }
  });
</script>

</BaseLayout>
