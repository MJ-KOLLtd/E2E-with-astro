---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<BaseLayout
  title="Projects | ESQUARE ESTATES"
  description="Explore premium residential developments by ESQUARE ESTATES — ESQUARE ESTATES Commonwealth in Ciudad Regina and 9 Handel Homes in Don Jose Heights, Quezon City."
  activeNav="projects"
>
    <section class="page-hero has-render has-texture">
      <HeroBackdrop render="/images/commonwealth/page01-img1.jpeg" />
      <div class="container inner hero-glass">
        <span class="eyebrow center">Our Projects</span>
        <h1>Curated homes for the discerning few.</h1>
        <p>Masterfully designed developments that blend architectural excellence, personalized experiences, and environmental harmony.</p>
      </div>
    </section>

    <section class="section bg-cream">
      <div class="container">
        <div class="projects-grid" style="margin-top:0">
          {projects.map((project) => (
            <ProjectCard project={project} primary />
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container">
        <h2>Experience our developments in person.</h2>
        <p>Schedule a private viewing with a property specialist.</p>
        <a href="/contact/" class="btn btn-dark btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
      </div>
    </section>
</BaseLayout>