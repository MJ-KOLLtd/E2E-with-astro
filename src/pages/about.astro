---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
---
<BaseLayout
  title="About | ESQUARE ESTATES"
  description="ESQUARE ESTATES redefines premium living with exclusive curated homes that embody sophistication, innovation, and enduring value."
  activeNav="about"
>
    <section class="page-hero has-render has-texture">
      <HeroBackdrop render="/images/commonwealth/page02-img2.jpeg" />
      <div class="container inner hero-glass">
        <span class="eyebrow center">About Us</span>
        <h1>Where your success finds its sanctuary.</h1>
        <p>To deliver masterfully designed developments that blend architectural excellence, personalized experiences, and environmental harmony — designed for the discerning few.</p>
      </div>
    </section>

    <section class="section bg-cream">
      <div class="container">
        <div class="story-grid">
          <div class="reveal">
            <span class="eyebrow">Our Story</span>
            <h2 style="font-size:clamp(2rem,3.6vw,2.85rem);margin:16px 0 16px">To redefine premium living.</h2>
            <p>ESQUARE ESTATES develops thoughtfully designed communities with a strategic focus on quality over quantity. We create limited, high-value properties for a select clientele — emphasizing refined aesthetics, thoughtful design, and superior craftsmanship.</p>
            <p>Our developments — <strong>ESQUARE ESTATES Commonwealth</strong> in Ciudad Regina and <strong>9 Handel Homes</strong> in Don Jose Heights — are exclusive two-unit enclaves crafted with the precision and care that defines every ESQUARE ESTATES project. Both are developed by Metrostar Realty &amp; Development Inc.</p>
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
              <a href="/projects/commonwealth/" class="btn btn-ghost">View Commonwealth <i class="fas fa-arrow-right arr"></i></a>
              <a href="/projects/9-handel-homes/" class="btn btn-ghost">View 9 Handel Homes <i class="fas fa-arrow-right arr"></i></a>
            </div>
          </div>
          <div class="story-visual reveal" style="padding:0;min-height:auto">
            <img src="/images/commonwealth/page03-img2.jpeg" alt="ESQUARE ESTATES Commonwealth architectural rendering" style="width:100%;height:100%;object-fit:cover;min-height:380px" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <section class="trustbar">
      <div class="container">
        <div class="tb-item"><b>Exclusivity</b><span>Limited, high-value properties</span></div>
        <div class="tb-item"><b>Integrity</b><span>Ethics, transparency, professionalism</span></div>
        <div class="tb-item"><b>Innovation</b><span>Smart and sustainable living</span></div>
        <div class="tb-seal"><i class="fas fa-gem"></i> Refined aesthetics. Enduring value.</div>
      </div>
    </section>

    <section class="section bg-white">
      <div class="container">
        <div class="section-head center reveal">
          <span class="eyebrow">Brand Values</span>
          <h2>The principles behind every development.</h2>
        </div>
        <div class="why-grid">
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-gem"></i></div><h3>Exclusivity</h3><p>We develop with intention, creating limited, high-value properties for a select clientele.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-palette"></i></div><h3>Refined</h3><p>We emphasize refined aesthetics, thoughtful design, and superior craftsmanship.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-handshake"></i></div><h3>Integrity</h3><p>We uphold the highest standards of ethics, transparency, and professionalism.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-leaf"></i></div><h3>Innovation</h3><p>We embrace smart and sustainable living solutions that enhance modern lifestyles.</p></div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container">
        <h2>Discover our exclusive townhouse developments.</h2>
        <p>Schedule a private viewing of ESQUARE ESTATES Commonwealth or 9 Handel Homes in Quezon City.</p>
        <a href="/contact/" class="btn btn-dark btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
      </div>
    </section>
</BaseLayout>