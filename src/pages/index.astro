---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Esquare Estates | Residential Communities in Bulacan"
  description="Esquare Estates builds flood-free master-planned residential communities in Bulacan. Now pre-selling: Oro Villas 2 in Bocaue."
  activeNav="home"
>
<!-- HERO -->
    <section class="hero">
      <svg class="hero-topo" viewBox="0 0 560 560" aria-hidden="true">
        <rect x="40" y="40" width="480" height="480" rx="120" transform="rotate(8 280 280)"/>
        <rect x="95" y="95" width="370" height="370" rx="95" transform="rotate(8 280 280)"/>
        <rect x="150" y="150" width="260" height="260" rx="70" transform="rotate(8 280 280)"/>
        <rect x="205" y="205" width="150" height="150" rx="45" transform="rotate(8 280 280)"/>
      </svg>
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Esquare Estates · Bocaue, Bulacan</span>
          <h1>A smarter address for <em>your next chapter.</em></h1>
          <p class="hero-sub">We build flood-free, master-planned residential communities in Bulacan — designed for everyday living and long-term value. Our flagship: Oro Villas 2.</p>
          <div class="hero-buttons">
            <a href="/projects/oro-villas/" class="btn btn-primary btn-lg">Explore Oro Villas 2 <i class="fas fa-arrow-right arr"></i></a>
            <a href="/contact/" class="btn btn-outline btn-lg">Get the Price List</a>
          </div>
          <div class="hero-trust">
            <!-- TODO: confirm these developer figures are publicly usable for this brand -->
            <div class="ht"><b>15+</b><span>Years developing</span></div>
            <div class="ht"><b>500+</b><span>Homes turned over</span></div>
            <div class="ht"><b>120k+</b><span>sqm developed</span></div>
          </div>
        </div>
        <div class="hero-visual">
          <span class="hero-tag">Flagship Community</span>
          <div class="hero-frame">
            <!-- TODO: drop a real Oro Villas 2 hero photo / render here (object-fit:cover) -->
            <div class="ph-icon"><i class="fas fa-tree-city"></i><span>Oro Villas 2 — Site Photo</span></div>
          </div>
          <div class="lot-card">
            <div class="lc-head">Oro Villas 2</div>
            <div class="lc-row"><span>Lot cuts</span><b>60–100 sqm</b></div>
            <div class="lc-row"><span>Status</span><b>Pre-selling</b></div>
            <div class="lc-row"><span>Location</span><b>Bocaue</b></div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST STRIP -->
    <section class="trustbar">
      <div class="container">
        <div class="tb-item"><b>SEC-Registered</b><span>Licensed Filipino developer</span></div>
        <div class="tb-item"><b>QC &amp; Bulacan</b><span>11 sold-out communities</span></div>
        <div class="tb-item"><b>Flood-Free</b><span>Elevated, well-drained sites</span></div>
        <div class="tb-seal"><i class="fas fa-shield-halved"></i> A developer with a 15-year track record</div>
      </div>
    </section>

    <!-- WHY -->
    <section class="section bg-cream">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">Why Esquare Estates</span>
          <h2>We build lots that hold their value.</h2>
          <p>Location, land size, and timing are the three levers of residential value. Every Esquare community is positioned to win on all three.</p>
        </div>
        <div class="why-grid">
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-location-dot"></i></div><h3>Prime locations</h3><p>Highway frontage and access to major roads, transit corridors, and Metro Manila.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-vector-square"></i></div><h3>Right-sized lots</h3><p>Efficient, buildable cuts priced for first homes and investors alike.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-arrow-trend-up"></i></div><h3>Real appreciation</h3><p>Sites beside growing commercial and infrastructure corridors in Bulacan.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-shield-halved"></i></div><h3>Flood-free &amp; secure</h3><p>Elevated, well-drained, master-planned communities built for peace of mind.</p></div>
        </div>
      </div>
    </section>

    <!-- FEATURED PROJECTS -->
    <section class="section bg-white">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">Our Communities</span>
          <h2>Where your next home could be.</h2>
          <p>One flagship community selling now, with more on the way across Bulacan.</p>
        </div>
        <div class="projects-grid">
          <article class="project-card reveal">
            <div class="project-img"><span class="proj-tag">Pre-selling</span><i class="fas fa-tree-city"></i></div>
            <div class="project-content">
              <div class="pc-loc"><i class="fas fa-location-dot"></i> Brgy. Wakas, Bocaue, Bulacan</div>
              <h3>Oro Villas 2</h3>
              <p>A flood-free, master-planned community along McArthur Highway — minutes from the Philippine Arena.</p>
              <div class="project-meta">
                <div class="pm"><b>60–100 sqm</b><span>Lot cuts</span></div>
                <div class="pm"><b>Pre-selling</b><span>Status</span></div>
              </div>
              <a href="/projects/oro-villas/" class="btn btn-ghost">View community <i class="fas fa-arrow-right arr"></i></a>
            </div>
          </article>
          <!-- TODO: replace these placeholders with real upcoming projects (or remove) -->
          <article class="project-card reveal">
            <div class="project-img"><span class="proj-tag soon">Coming soon</span><i class="fas fa-drafting-compass"></i></div>
            <div class="project-content">
              <div class="pc-loc"><i class="fas fa-location-dot"></i> Bulacan</div>
              <h3>New Community</h3>
              <p>Our next master-planned development. Register your interest to get first access and launch pricing.</p>
              <div class="project-meta"><div class="pm"><b>TBA</b><span>Details</span></div></div>
              <a href="/contact/" class="btn btn-ghost">Get notified <i class="fas fa-arrow-right arr"></i></a>
            </div>
          </article>
          <article class="project-card reveal">
            <div class="project-img"><span class="proj-tag soon">Coming soon</span><i class="fas fa-drafting-compass"></i></div>
            <div class="project-content">
              <div class="pc-loc"><i class="fas fa-location-dot"></i> Bulacan</div>
              <h3>New Community</h3>
              <p>More residential lots in emerging, high-growth areas. Early buyers get the best positions and prices.</p>
              <div class="project-meta"><div class="pm"><b>TBA</b><span>Details</span></div></div>
              <a href="/contact/" class="btn btn-ghost">Get notified <i class="fas fa-arrow-right arr"></i></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ABOUT TEASER -->
    <section class="section bg-cream">
      <div class="container">
        <div class="story-grid">
          <div class="reveal">
            <span class="eyebrow">Who We Are</span>
            <h2 style="font-size:clamp(2rem,3.6vw,2.85rem);margin:16px 0 16px">A trusted partner for property in Bulacan.</h2>
            <p>Esquare Estates is a Filipino real estate developer focused on accessible, well-located, flood-free communities. We plan for the long term — practical layouts, dependable infrastructure, and locations built to appreciate.</p>
            <p>Backed by a development group with a 15-year track record across Quezon City and Bulacan, we help families and investors buy with confidence.</p>
            <a href="/about/" class="btn btn-ghost" style="margin-top:8px">More about us <i class="fas fa-arrow-right arr"></i></a>
          </div>
          <div class="story-visual reveal">
            <!-- TODO: replace with a real community / team photo -->
            <div class="ph-icon"><i class="fas fa-people-roof"></i><span>Community Photo</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- EVENT TEASER -->
    <section class="section event">
      <div class="container">
        <div class="section-head reveal" style="margin-bottom:36px">
          <span class="eyebrow">Upcoming Event</span>
          <h2 style="font-size:clamp(2rem,3.4vw,2.7rem);margin-top:16px">See it for yourself.</h2>
        </div>
        <div class="event-card reveal">
          <div class="event-info">
            <span class="event-badge"><i class="far fa-calendar-alt"></i> June 25, 2026</span>
            <h3>Oro Villas 2 Launch Event</h3>
            <p class="e-time">10:00 AM – 2:00 PM · On-site networking</p>
            <p>A Modern Filipino Gathering for brokers, sellers, and investors — site tour, broker incentives, a Filipino buffet, and a raffle. Slots are limited.</p>
            <a href="/events/" class="btn btn-primary btn-lg">Event details <i class="fas fa-arrow-right arr"></i></a>
          </div>
          <div class="event-side">
            <div class="es-item"><b>50–100</b><span>Guests expected</span></div>
            <div class="es-item"><b>70%</b><span>Broker accreditation target</span></div>
            <div class="es-item"><b>Lechon</b><span>&amp; full Filipino feast</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BAND -->
    <section class="cta-band">
      <div class="container">
        <h2>Lots are moving. Yours shouldn't wait.</h2>
        <p>Pre-selling prices won't last. Reserve your lot at Oro Villas 2 today.</p>
        <a href="/contact/" class="btn btn-dark btn-lg">Inquire now <i class="fas fa-arrow-right arr"></i></a>
      </div>
    </section>
</BaseLayout>
