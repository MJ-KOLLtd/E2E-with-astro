---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import commonwealth from '../data/projects/commonwealth';

const hero = commonwealth.hero;
---
<BaseLayout
  title="ESQUARE ESTATES Commonwealth | Exclusive Townhouses in Ciudad Regina"
  description="Discover ESQUARE ESTATES Commonwealth — a limited two-unit contemporary townhouse enclave in Ciudad Regina, Quezon City. Schedule a private viewing today."
  ogImage="/images/commonwealth/page01-img2.jpeg"
  activeNav="home"
>
    <section class="hero hero-property">
      <HeroBackdrop texture={false} topo={false} />
      <div class="container hero-grid">
        <div class="hero-copy hero-glass">
          <span class="eyebrow">{hero.eyebrow}</span>
          <h1>{hero.headline}</h1>
          <p class="hero-sub">{hero.subheadline}</p>
          <div class="hero-buttons">
            <a href="/projects/commonwealth/" class="btn btn-primary btn-lg">View Commonwealth <i class="fas fa-arrow-right arr"></i></a>
            <a href="#inquire" class="btn btn-outline btn-lg">Schedule a Viewing</a>
          </div>
          <div class="hero-trust">
            {hero.trustStats.map((stat) => (
              <div class="ht"><b>{stat.value}</b><span>{stat.label}</span></div>
            ))}
          </div>
        </div>
        <div class="hero-visual hero-showcase">
          <span class="hero-tag">{hero.tag}</span>
          <div class="hero-frame hero-frame--property">
            <img
              src="/images/commonwealth/page01-img2.jpeg"
              alt="ESQUARE ESTATES Commonwealth exterior architectural rendering"
              width="900"
              height="1125"
              loading="eager"
            >
            <aside class="property-summary property-summary--dropdown" aria-label="ESQUARE ESTATES Commonwealth property summary">
              <button type="button" class="ps-toggle" aria-expanded="false" aria-controls="propertySummaryPanel">
                <span class="ps-toggle-label">ESQUARE ESTATES Commonwealth</span>
                <i class="fas fa-chevron-down ps-chevron" aria-hidden="true"></i>
              </button>
              <div class="ps-panel" id="propertySummaryPanel">
                <p class="ps-location">Ciudad Regina, Quezon City</p>
                <ul class="ps-highlights">
                  <li>2 Exclusive Units</li>
                  <li>4 Bedrooms</li>
                  <li>±245.25 sqm Gross Floor Area</li>
                  <li>Modern Contemporary Architecture</li>
                </ul>
                <a href="#inquire" class="ps-cta">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <script>
      const summary = document.querySelector('.property-summary--dropdown');
      const toggle = summary?.querySelector('.ps-toggle');
      toggle?.addEventListener('click', () => {
        const open = summary?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    </script>

    <section class="trustbar">
      <div class="container">
        <div class="tb-item"><b>Exclusivity</b><span>Limited, high-value properties</span></div>
        <div class="tb-item"><b>Design</b><span>Architecture that transcends trends</span></div>
        <div class="tb-item"><b>Location</b><span>Prime address with intention</span></div>
        <div class="tb-seal"><i class="fas fa-gem"></i> Where your success finds its sanctuary.</div>
      </div>
    </section>

    <section class="section leadgen" id="inquire">
      <div class="container lead-grid">
        <div class="lead-copy reveal">
          <span class="eyebrow">Schedule a Viewing</span>
          <h2>Begin your inquiry today.</h2>
          <p>Complete the form and a property specialist will contact you with project details, availability, and viewing options for our Quezon City developments.</p>
          <ul class="lead-points">
            <li><i class="fas fa-calendar-check"></i> Private viewing by appointment</li>
            <li><i class="fas fa-file-invoice"></i> Full brochure and specifications</li>
            <li><i class="fas fa-bolt"></i> Reply within 1 business day</li>
          </ul>
        </div>
        <InquiryForm
          id="home"
          variant="lead"
          title="Send your inquiry"
          subject="ESQUARE ESTATES — Homepage Inquiry"
        />
      </div>
    </section>

    <section class="section bg-cream">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">Why ESQUARE ESTATES</span>
          <h2>Distinction, legacy, and elevated living.</h2>
          <p>We develop thoughtfully designed communities with a strategic focus on quality over quantity — for the discerning few.</p>
        </div>
        <div class="why-grid">
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-gem"></i></div><h3>Exclusivity Redefined</h3><p>We deliver more than homes — distinction, legacy, and the promise of elevated living.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-location-dot"></i></div><h3>Location With Intention</h3><p>Prime address. Peaceful abode. Proximity without compromise.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-building"></i></div><h3>Design That Transcends Trends</h3><p>Timeless architecture meets the innovations of tomorrow.</p></div>
          <div class="why-card reveal"><div class="wc-ico"><i class="fas fa-shield-halved"></i></div><h3>A Legacy That Lives On</h3><p>Your home is more than a place — it is a statement for generations.</p></div>
        </div>
      </div>
    </section>

    <section class="section bg-white">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">Our Projects</span>
          <h2>Elevated experiences, curated with intention.</h2>
          <p>Exclusive two-unit townhouse developments in prime Quezon City locations — each crafted with a distinct architectural vision.</p>
        </div>
        <div class="projects-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-cream">
      <div class="container">
        <div class="story-grid">
          <div class="reveal">
            <span class="eyebrow">Who We Are</span>
            <h2 style="font-size:clamp(2rem,3.6vw,2.85rem);margin:16px 0 16px">To redefine premium living.</h2>
            <p>ESQUARE ESTATES develops masterfully designed communities that blend architectural excellence, personalized experiences, and environmental harmony — designed for the discerning few.</p>
            <p>Every ESQUARE ESTATES project embodies sophistication, innovation, and enduring value — crafted for the discerning few.</p>
            <a href="/about/" class="btn btn-ghost" style="margin-top:8px">More about us <i class="fas fa-arrow-right arr"></i></a>
          </div>
          <div class="story-visual reveal" style="padding:0;min-height:auto">
            <img src="/images/commonwealth/page10-img1.jpeg" alt="ESQUARE ESTATES Commonwealth porch and linear garden rendering" style="width:100%;height:100%;object-fit:cover;min-height:380px" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <section class="section event">
      <div class="container">
        <div class="section-head reveal" style="margin-bottom:36px">
          <span class="eyebrow">Private Viewings</span>
          <h2 style="font-size:clamp(2rem,3.4vw,2.7rem);margin-top:16px">Experience it in person.</h2>
        </div>
        <div class="event-card reveal">
          <div class="event-info">
            <span class="event-badge"><i class="far fa-calendar-alt"></i> By appointment</span>
            <h3>ESQUARE ESTATES Private Viewings</h3>
            <p class="e-time">Quezon City · Private tours available</p>
            <p>Schedule a personal viewing of our exclusive townhouse developments. A property specialist will guide you through the project, specifications, and floor plans.</p>
            <a href="/contact/" class="btn btn-primary btn-lg">Schedule a viewing <i class="fas fa-arrow-right arr"></i></a>
          </div>
          <div class="event-side">
            <div class="es-item"><b>2</b><span>Premium projects</span></div>
            <div class="es-item"><b>4</b><span>Bedrooms per unit</span></div>
            <div class="es-item"><b>QC</b><span>Prime locations</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container">
        <h2>Where your success finds its sanctuary.</h2>
        <p>Explore ESQUARE ESTATES Commonwealth and 9 Handel Homes. Schedule your private viewing today.</p>
        <a href="#inquire" class="btn btn-dark btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
      </div>
    </section>
</BaseLayout>