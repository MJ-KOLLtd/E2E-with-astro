---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Events | Oro Villas 2 Launch — Esquare Estates"
  description="Join the Oro Villas 2 Launch Event on June 25 2026 in Bocaue, Bulacan. Site tour, broker incentives, and Filipino buffet."
  activeNav="events"
>
<section class="page-hero">
      <div class="container inner">
        <span class="eyebrow center">Events</span>
        <h1>See it for yourself.</h1>
        <p>Meet the team, tour the site, and explore Oro Villas 2 in person.</p>
        <div class="ph-cta"><a href="/contact/" class="btn btn-primary btn-lg">Reserve your slot <i class="fas fa-arrow-right arr"></i></a></div>
      </div>
    </section>

    <!-- EVENT CARD -->
    <section class="section bg-cream">
      <div class="container">
        <div class="event-card reveal">
          <div class="event-info">
            <span class="event-badge"><i class="far fa-calendar-alt"></i> June 25, 2026</span>
            <h3>Oro Villas 2 Launch Event</h3>
            <p class="e-time">10:00 AM – 2:00 PM · On-site networking</p>
            <p>A Modern Filipino Gathering for brokers, sellers, and investors. Expect a guided site tour, broker incentives, a Filipino buffet, and a raffle. Slots are limited — reserve early to secure your place.</p>
            <a href="/contact/" class="btn btn-primary btn-lg">Reserve your slot <i class="fas fa-arrow-right arr"></i></a>
          </div>
          <div class="event-side">
            <div class="es-item"><b>50–100</b><span>Guests expected</span></div>
            <div class="es-item"><b>70%</b><span>Broker accreditation target</span></div>
            <div class="es-item"><b>Lechon</b><span>&amp; full Filipino feast</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROGRAM -->
    <section class="section bg-white">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">Program of the Day</span>
          <h2>What to expect.</h2>
          <p>A relaxed, half-day gathering — come anytime within the window.</p>
        </div>
        <!-- TODO: confirm the actual program / times below -->
        <div class="schedule-list reveal">
          <div class="schedule-item"><div class="schedule-time">10:00 AM</div><div><b>Registration &amp; welcome</b><br><span style="color:var(--ink-600)">Sign in, welcome drinks, and brand introduction.</span></div></div>
          <div class="schedule-item"><div class="schedule-time">10:30 AM</div><div><b>Guided site tour</b><br><span style="color:var(--ink-600)">Walk the community, view lot cuts and the master plan.</span></div></div>
          <div class="schedule-item"><div class="schedule-time">11:30 AM</div><div><b>Investment &amp; pricing briefing</b><br><span style="color:var(--ink-600)">Pricing, payment terms, and broker incentives explained.</span></div></div>
          <div class="schedule-item"><div class="schedule-time">12:00 PM</div><div><b>Filipino buffet &amp; networking</b><br><span style="color:var(--ink-600)">Lechon and a full Filipino feast with the team.</span></div></div>
          <div class="schedule-item"><div class="schedule-time">1:30 PM</div><div><b>Raffle &amp; reservations</b><br><span style="color:var(--ink-600)">Prizes, and on-site reservation assistance for buyers.</span></div></div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container">
        <h2>Slots are limited.</h2>
        <p>Reserve your place at the Oro Villas 2 Launch Event.</p>
        <a href="/contact/" class="btn btn-dark btn-lg">Reserve your slot <i class="fas fa-arrow-right arr"></i></a>
      </div>
    </section>
</BaseLayout>
