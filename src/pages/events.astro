---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
---
<BaseLayout
  title="Events | ESQUARE ESTATES Commonwealth Viewings"
  description="Schedule a private viewing of ESQUARE ESTATES Commonwealth in Ciudad Regina, Quezon City. Experience the exclusive two-unit townhouse enclave in person."
  activeNav="events"
>
    <section class="page-hero has-render has-texture">
      <HeroBackdrop render="/images/commonwealth/page03-img2.jpeg" />
      <div class="container inner hero-glass">
        <span class="eyebrow center">Events</span>
        <h1>Experience it in person.</h1>
        <p>Schedule a private viewing of ESQUARE ESTATES Commonwealth in Ciudad Regina, Quezon City.</p>
        <div class="ph-cta"><a href="/contact/" class="btn btn-primary btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a></div>
      </div>
    </section>

    <section class="section bg-cream">
      <div class="container">
        <div class="event-card reveal">
          <div class="event-info">
            <span class="event-badge"><i class="far fa-calendar-alt"></i> By appointment</span>
            <h3>ESQUARE ESTATES Commonwealth Private Viewing</h3>
            <p class="e-time">Ciudad Regina, Quezon City · Flexible scheduling</p>
            <p>Experience the exclusive two-unit contemporary townhouse enclave firsthand. A property specialist will guide you through the development, floor plans, material specifications, and nearby establishments.</p>
            <a href="/contact/" class="btn btn-primary btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
          </div>
          <div class="event-side">
            <div class="es-item"><b>2</b><span>Exclusive units</span></div>
            <div class="es-item"><b>4</b><span>Bedrooms per unit</span></div>
            <div class="es-item"><b>QC</b><span>Ciudad Regina address</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-white">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">What to Expect</span>
          <h2>Your private viewing experience.</h2>
          <p>A curated tour of ESQUARE ESTATES Commonwealth — tailored to your schedule and interests.</p>
        </div>
        <div class="schedule-list reveal">
          <div class="schedule-item"><div class="schedule-time">Welcome</div><div><b>Introduction &amp; project overview</b><br><span style="color:var(--ink-600)">Learn about the development, ESQUARE ESTATES vision, and exclusive two-unit concept.</span></div></div>
          <div class="schedule-item"><div class="schedule-time">Tour</div><div><b>Site and unit walkthrough</b><br><span style="color:var(--ink-600)">Explore the contemporary architecture, layouts, and outdoor spaces.</span></div></div>
          <div class="schedule-item"><div class="schedule-time">Review</div><div><b>Floor plans &amp; specifications</b><br><span style="color:var(--ink-600)">Review material specifications, amenities, and unit details.</span></div></div>
          <div class="schedule-item"><div class="schedule-time">Discuss</div><div><b>Q&amp;A with property specialist</b><br><span style="color:var(--ink-600)">Ask questions about availability, payment terms, and next steps.</span></div></div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container">
        <h2>Only two units available.</h2>
        <p>Schedule your private viewing at ESQUARE ESTATES Commonwealth.</p>
        <a href="/contact/" class="btn btn-dark btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
      </div>
    </section>
</BaseLayout>