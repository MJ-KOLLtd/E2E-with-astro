---
import '../styles/global.css';

export interface Props {
  title:       string;
  description?: string;
  activeNav?:  string;
  ogImage?:    string;
  ogType?:     string;
  canonical?:  string;
  noindex?:    boolean;
}

const site = 'https://esquareestates.com';

const {
  title,
  description = 'ESQUARE ESTATES — Premium residential developments in Metro Manila. Where your success finds its sanctuary.',
  activeNav = '',
  ogImage = '/images/commonwealth/page01-img1.jpeg',
  ogType = 'website',
  canonical,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, site).href;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: 'ESQUARE ESTATES',
  url: site,
  logo: new URL('/e2e-logo-white.png', site).href,
  slogan: 'Where your success finds its sanctuary.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Quezon City',
    addressRegion: 'Metro Manila',
    addressCountry: 'PH',
  },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={canonicalUrl}>

  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="ESQUARE ESTATES">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:alt" content="ESQUARE ESTATES Commonwealth exterior rendering">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  <slot name="head" />
</head>
<body>

  <div class="topbar">
    <div class="container">
      <span class="pulse"><span class="dot"></span> ESQUARE ESTATES · Commonwealth &amp; 9 Handel Homes — exclusive two-unit townhouse developments in Quezon City</span>
      <div class="tb-right">
        <a class="tb-hide" href="tel:+6321234567"><i class="fas fa-phone-alt"></i> +63 (2) 1234 5678</a>
        <a href="#"><i class="fab fa-viber"></i> Chat on Viber</a>
      </div>
    </div>
  </div>

  <header class="site-header" id="siteHeader">
    <div class="container header-container">
      <div class="logo-area">
        <a href="/"><img src="/e2e-logo-white.png" alt="ESQUARE ESTATES" class="brand-logo"></a>
      </div>
      <nav class="main-nav">
        <ul class="nav-list">
          <li><a href="/"                    class={activeNav === 'home'     ? 'active' : ''}>Home</a></li>
          <li><a href="/projects/"           class={activeNav === 'projects' ? 'active' : ''}>Projects</a></li>
          <li><a href="/about/"              class={activeNav === 'about'    ? 'active' : ''}>About</a></li>
          <li><a href="/events/"             class={activeNav === 'events'   ? 'active' : ''}>Events</a></li>
          <li><a href="/blog/"               class={activeNav === 'blog'     ? 'active' : ''}>Blog</a></li>
          <li><a href="/contact/"            class={activeNav === 'contact'  ? 'active' : ''}>Contact</a></li>
        </ul>
        <div class="nav-cta">
          <a href="/contact/" class="btn btn-primary">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
          <div class="mobile-menu-icon"><i class="fas fa-bars"></i></div>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <img src="/e2e-logo-white.png" alt="ESQUARE ESTATES" class="brand-logo">
          <p>Masterfully designed developments that blend architectural excellence, personalized experiences, and environmental harmony — designed for the discerning few.</p>
          <p class="footer-tagline">Where your success finds its sanctuary.</p>
          <div class="social-icons">
            <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="#" aria-label="Viber"><i class="fab fa-viber"></i></a>
            <a href="#" aria-label="Messenger"><i class="fab fa-facebook-messenger"></i></a>
          </div>
        </div>
        <div class="footer-links"><h4>Explore</h4><ul>
          <li><a href="/">Home</a></li>
          <li><a href="/projects/">Projects</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/events/">Events</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul></div>
        <div class="footer-links"><h4>Projects</h4><ul>
          <li><a href="/projects/commonwealth/">ESQUARE ESTATES Commonwealth</a></li>
          <li><a href="/projects/9-handel-homes/">9 Handel Homes</a></li>
          <li><a href="/contact/">Schedule a viewing</a></li>
          <li><a href="/projects/">View all projects</a></li>
        </ul></div>
        <div class="footer-contact"><h4>Connect</h4>
          <p><i class="fas fa-envelope"></i> hello@esquareestates.com</p>
          <p><i class="fas fa-phone-alt"></i> +63 (2) 1234 5678</p>
          <p><i class="fas fa-map-pin"></i> Ciudad Regina, Quezon City</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} ESQUARE ESTATES — Where your success finds its sanctuary.</p>
        <p>Premium residential developments in Metro Manila.</p>
      </div>
    </div>
  </footer>

  <div class="mobile-cta">
    <a class="mc-call" href="tel:+6321234567"><i class="fas fa-phone-alt"></i> Call</a>
    <a class="mc-inq" href="/contact/"><i class="fas fa-arrow-right"></i> Inquire</a>
  </div>

  <script>
    document.querySelector('.mobile-menu-icon')
      ?.addEventListener('click', () => document.querySelector('.nav-list')?.classList.toggle('show'));
    const h = document.getElementById('siteHeader');
    window.addEventListener('scroll', () => h?.classList.toggle('scrolled', window.scrollY > 30));
    const io = new IntersectionObserver(
      (es) => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</body>
</html>