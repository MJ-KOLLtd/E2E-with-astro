---
import type { Project } from '../data/projects/types';

interface Props {
  project: Project;
  primary?: boolean;
}

const { project, primary = false } = Astro.props;
const href = `/projects/${project.slug}/`;
---
<article class="project-card reveal">
  <div class="project-img" style="padding:0;overflow:hidden">
    <span class="proj-tag">{project.status}</span>
    <img
      src={project.portfolio.cardImage}
      alt={project.portfolio.cardImageAlt}
      style="width:100%;height:100%;object-fit:cover"
      loading="lazy"
    >
  </div>
  <div class="project-content">
    <div class="pc-loc"><i class="fas fa-location-dot"></i> {project.location}</div>
    <h3>{project.name}</h3>
    <p>{project.portfolio.excerpt}</p>
    <div class="project-meta">
      {project.portfolio.meta.map((m) => (
        <div class="pm"><b>{m.value}</b><span>{m.label}</span></div>
      ))}
    </div>
    <a href={href} class={primary ? 'btn btn-primary' : 'btn btn-ghost'}>
      View project <i class="fas fa-arrow-right arr"></i>
    </a>
  </div>
</article>