---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import InquiryForm from './InquiryForm.astro';
import type { Project } from '../data/projects/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const site = 'https://esquareestates.com';
const canonical = `${site}/projects/${project.slug}/`;

const residenceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Residence',
  name: project.name,
  description: project.seo.description,
  url: canonical,
  image: new URL(project.seo.ogImage, site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: project.jsonLd.addressLocality,
    addressRegion: 'Metro Manila',
    addressCountry: 'PH',
  },
  numberOfRooms: project.jsonLd.numberOfRooms,
  numberOfBathroomsTotal: project.jsonLd.numberOfBathroomsTotal,
  floorSize: { '@type': 'QuantitativeValue', value: project.jsonLd.floorSize, unitCode: 'MTK' },
  amenityFeature: project.overview.amenities.map((name) => ({
    '@type': 'LocationFeatureSpecification',
    name,
    value: true,
  })),
};
---
<BaseLayout
  title={project.seo.title}
  description={project.seo.description}
  ogImage={project.seo.ogImage}
  ogType="website"
  canonical={canonical}
  activeNav="projects"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(residenceJsonLd)} />
  </Fragment>

  <section class="hero has-render has-texture">
    <HeroBackdrop render={project.hero.render} />
    <div class="container hero-grid">
      <div class="hero-copy hero-glass">
        <span class="eyebrow">{project.hero.eyebrow}</span>
        <h1>{project.hero.headline}</h1>
        <p class="hero-sub">{project.hero.subheadline}</p>
        <div class="hero-buttons">
          <a href="#inquire" class="btn btn-primary btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
          <a href="#floor-plans" class="btn btn-outline btn-lg">View Floor Plans</a>
        </div>
        <div class="hero-trust">
          {project.hero.trustStats.map((stat) => (
            <div class="ht"><b>{stat.value}</b><span>{stat.label}</span></div>
          ))}
        </div>
      </div>
      <div class="hero-visual hero-glass">
        <span class="hero-tag">{project.hero.tag}</span>
        <div class="hero-frame">
          <img
            src={project.hero.frameImage}
            alt={project.hero.frameAlt}
            width="800"
            height="1000"
            loading="eager"
          >
        </div>
        <div class="lot-card">
          <div class="lc-head">{project.hero.lotCard.title}</div>
          {project.hero.lotCard.rows.map((row) => (
            <div class="lc-row"><span>{row.label}</span><b>{row.value}</b></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section leadgen" id="inquire">
    <div class="container lead-grid">
      <div class="lead-copy reveal">
        <span class="eyebrow">Schedule a Viewing</span>
        <h2>{project.inquiry.headline}</h2>
        <p>{project.inquiry.description}</p>
        <ul class="lead-points">
          {project.inquiry.points.map((point) => (
            <li><i class={point.icon}></i> {point.text}</li>
          ))}
        </ul>
      </div>
      <InquiryForm
        id={project.inquiry.formId}
        variant="lead"
        title={project.inquiry.formTitle}
        subtitle="Fields marked * are required. We reply within 1 business day."
        subject={project.inquiry.subject}
      />
    </div>
  </section>

  <section class="section bg-cream" id="about">
    <div class="container">
      <div class="story-grid">
        <div class="reveal">
          <span class="eyebrow">{project.about.eyebrow}</span>
          <h2 style="font-size:clamp(2rem,3.6vw,2.85rem);margin:16px 0 16px">{project.about.headline}</h2>
          {project.about.paragraphs.map((p) => <p>{p}</p>)}
          <ul class="feature-list">
            {project.about.features.map((f) => (
              <li><i class="fas fa-circle-check"></i> {f}</li>
            ))}
          </ul>
        </div>
        <div class="story-visual reveal" style="padding:0;min-height:auto">
          <img
            src={project.about.image}
            alt={project.about.imageAlt}
            style="width:100%;height:100%;object-fit:cover;min-height:380px"
            loading="lazy"
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow">{project.whyChoose.eyebrow}</span>
        <h2>{project.whyChoose.headline}</h2>
        <p>{project.whyChoose.description}</p>
      </div>
      <div class="why-grid">
        {project.whyChoose.cards.map((card) => (
          <div class="why-card reveal">
            <div class="wc-ico"><i class={card.icon}></i></div>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="overview">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{project.overview.eyebrow}</span>
        <h2>{project.overview.headline}</h2>
        <p>{project.overview.description}</p>
      </div>
      <div class="overview-grid reveal">
        {project.overview.stats.map((stat) => (
          <div class="overview-stat"><b>{stat.value}</b><span>{stat.label}</span></div>
        ))}
      </div>
      <div class="reveal">
        <h3 style="font-size:1.25rem;margin-bottom:4px">Home Amenities</h3>
        <div class="amenity-list">
          {project.overview.amenities.map((a) => <span>{a}</span>)}
        </div>
      </div>
      <div class="proj-grid" style="margin-top:48px">
        {project.overview.unitImages.map((img) => (
          <div class="reveal">
            <img
              src={img.src}
              alt={img.alt}
              style="border-radius:var(--r-lg);box-shadow:var(--sh-md)"
              loading="lazy"
            >
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white" id="location">
    <div class="container">
      <div class="loc-grid">
        <div class="loc-copy reveal">
          <span class="eyebrow">{project.locationSection.eyebrow}</span>
          <h2 style="font-size:clamp(2rem,3.6vw,2.95rem);margin:16px 0 18px">{project.locationSection.headline}</h2>
          <p style="color:var(--ink-600);font-size:1.08rem;margin-bottom:24px">{project.locationSection.description}</p>
          {project.locationSection.categories.map((cat) => (
            <div class="loc-category">
              <h4>{cat.title}</h4>
              {cat.entries.map((entry) => (
                <div class="loc-est"><b>{entry.name}</b><span>{entry.minutes}</span></div>
              ))}
            </div>
          ))}
        </div>
        <div class="reveal">
          <img
            src={project.locationSection.mapImage}
            alt={project.locationSection.mapAlt}
            style="border-radius:var(--r-lg);box-shadow:var(--sh-lg);width:100%"
            loading="lazy"
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="gallery">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{project.gallery.eyebrow}</span>
        <h2>{project.gallery.headline}</h2>
        <p>{project.gallery.description}</p>
      </div>
      <div class="gallery-tabs reveal" role="tablist">
        {project.gallery.tabs.map((tab, i) => (
          <button
            class={`gallery-tab${i === 0 ? ' active' : ''}`}
            data-filter={tab.id}
            type="button"
          >{tab.label}</button>
        ))}
      </div>
      <div class="gallery-masonry reveal">
        {project.gallery.items.map((item) => (
          <figure class="gallery-item" data-cat={item.category}>
            <img src={item.src} alt={`${project.name} — ${item.label}`} loading="lazy">
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white" id="floor-plans">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{project.floorPlans.eyebrow}</span>
        <h2>{project.floorPlans.headline}</h2>
        <p>{project.floorPlans.description}</p>
      </div>
      <div class="floorplan-grid reveal">
        {project.floorPlans.plans.map((plan, i) => (
          <div class="floorplan-card" data-floorplan={i}>
            <h4>{plan.title}</h4>
            <div class="floorplan-viewport">
              <img src={plan.src} alt={`${project.name} — ${plan.title}`} draggable="false" loading="lazy">
            </div>
            <div class="floorplan-controls">
              <button type="button" class="fp-zoom-out" aria-label="Zoom out"><i class="fas fa-minus"></i></button>
              <span class="fp-scale">100%</span>
              <button type="button" class="fp-zoom-in" aria-label="Zoom in"><i class="fas fa-plus"></i></button>
              <button type="button" class="fp-reset" aria-label="Reset zoom" title="Reset"><i class="fas fa-compress"></i></button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="specifications">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{project.specifications.eyebrow}</span>
        <h2>{project.specifications.headline}</h2>
        <p>{project.specifications.description}</p>
      </div>
      <div class="specs-accordion reveal">
        {project.specifications.sections.map((section, i) => (
          <div class={`specs-item${i === 0 ? ' open' : ''}`}>
            <button class="specs-trigger" type="button">{section.title} <i class="fas fa-chevron-down"></i></button>
            <div class="specs-panel"><div class="specs-body">
              {section.subsections.map((sub) => (
                <>
                  {sub.heading && <h5>{sub.heading}</h5>}
                  <ul>
                    {sub.items.map((item) => <li>{item}</li>)}
                  </ul>
                </>
              ))}
            </div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>{project.cta.headline}</h2>
      <p>{project.cta.description}</p>
      <a href="#inquire" class="btn btn-dark btn-lg">Schedule a Viewing <i class="fas fa-arrow-right arr"></i></a>
    </div>
  </section>

  <div class="lightbox" id="galleryLightbox" role="dialog" aria-modal="true" aria-label="Gallery image viewer">
    <button class="lightbox-close" type="button" aria-label="Close"><i class="fas fa-times"></i></button>
    <img src="" alt="" id="lightboxImg">
    <span class="lightbox-caption" id="lightboxCaption"></span>
  </div>

  <script>
    document.querySelectorAll('.gallery-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.gallery-tab').forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        const filter = tab.dataset.filter;
        document.querySelectorAll('.gallery-item').forEach((item) => {
          const show = filter === 'all' || item.dataset.cat === filter;
          item.classList.toggle('hidden', !show);
        });
      });
    });

    const lb = document.getElementById('galleryLightbox');
    const lbImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
    const lbCap = document.getElementById('lightboxCaption');
    document.querySelectorAll('.gallery-item').forEach((item) => {
      item.addEventListener('click', () => {
        const img = item.querySelector('img');
        const cap = item.querySelector('figcaption');
        if (!img || !lb || !lbImg) return;
        lbImg.src = img.src;
        lbImg.alt = img.alt;
        if (lbCap && cap) lbCap.textContent = cap.textContent;
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    });
    lb?.querySelector('.lightbox-close')?.addEventListener('click', () => {
      lb.classList.remove('open');
      document.body.style.overflow = '';
    });
    lb?.addEventListener('click', (e) => {
      if (e.target === lb) {
        lb.classList.remove('open');
        document.body.style.overflow = '';
      }
    });

    document.querySelectorAll('.specs-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.specs-item');
        const wasOpen = item?.classList.contains('open');
        document.querySelectorAll('.specs-item').forEach((i) => i.classList.remove('open'));
        if (!wasOpen) item?.classList.add('open');
      });
    });

    document.querySelectorAll('.floorplan-card').forEach((card) => {
      const img = card.querySelector('.floorplan-viewport img') as HTMLImageElement | null;
      const scaleEl = card.querySelector('.fp-scale');
      let scale = 1;
      let panX = 0, panY = 0;
      let dragging = false, startX = 0, startY = 0;

      const apply = () => {
        if (!img) return;
        img.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
        if (scaleEl) scaleEl.textContent = `${Math.round(scale * 100)}%`;
      };

      card.querySelector('.fp-zoom-in')?.addEventListener('click', () => {
        scale = Math.min(scale + 0.25, 3);
        apply();
      });
      card.querySelector('.fp-zoom-out')?.addEventListener('click', () => {
        scale = Math.max(scale - 0.25, 1);
        if (scale === 1) { panX = 0; panY = 0; }
        apply();
      });
      card.querySelector('.fp-reset')?.addEventListener('click', () => {
        scale = 1; panX = 0; panY = 0;
        apply();
      });

      const viewport = card.querySelector('.floorplan-viewport');
      viewport?.addEventListener('mousedown', (e) => {
        if (scale <= 1) return;
        dragging = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
        (viewport as HTMLElement).style.cursor = 'grabbing';
      });
      window.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        apply();
      });
      window.addEventListener('mouseup', () => {
        dragging = false;
        if (viewport) (viewport as HTMLElement).style.cursor = scale > 1 ? 'grab' : 'zoom-in';
      });
    });
  </script>
</BaseLayout>